{
  "name": "splayer-cloudflare",
  "version": "1.0.0",
  "private": true,
  "description": "SPlayer + api-enhanced 全 Cloudflare 部署方案",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "login": "npx wrangler login",
    "deps:status": "node scripts/deps.mjs status",
    "deps:setup": "node scripts/deps.mjs setup",
    "deps:apply": "node scripts/deps.mjs apply",
    "deps:update": "node scripts/deps.mjs update",
    "build:api": "node workers/api/scripts/build-modules.cjs",
    "test:api": "node workers/api/scripts/test-api.cjs",
    "test:scripts": "bash scripts/tests/deploy-scripts.test.sh",
    "dev:proxy": "cd workers/music-proxy && npx wrangler dev",
    "dev:api": "cd workers/api && npx wrangler dev",
    "deploy:proxy": "node scripts/deploy.mjs proxy",
    "deploy:api": "node scripts/deploy.mjs api",
    "deploy:pages": "node scripts/deploy.mjs pages",
    "deploy:all": "node scripts/deploy.mjs all",
    "deploy:proxy:bash": "bash scripts/deploy-proxy-worker.sh",
    "deploy:api:bash": "bash scripts/deploy-api-worker.sh",
    "deploy:pages:bash": "bash scripts/deploy-pages.sh",
    "deploy:all:bash": "bash scripts/deploy-all.sh"
  },
  "devDependencies": {
    "wrangler": "^4.144.0"
  }
}
