{
  "name": "splayer-cloudflare",
  "version": "1.0.0",
  "description": "SPlayer + api-enhanced 全 Cloudflare 部署方案",
  "scripts": {
    "login": "npx wrangler login",
    "deploy:proxy": "powershell -ExecutionPolicy Bypass -File scripts/deploy-proxy-worker.ps1",
    "deploy:api": "powershell -ExecutionPolicy Bypass -File scripts/deploy-api-worker.ps1",
    "deploy:pages": "powershell -ExecutionPolicy Bypass -File scripts/deploy-pages.ps1",
    "deploy:all": "powershell -ExecutionPolicy Bypass -File scripts/deploy-all.ps1",
    "dev:proxy": "cd workers/music-proxy && npx wrangler dev",
    "dev:api": "cd workers/api && npx wrangler dev",
    "setup:api": "cd workers/api && node scripts/setup-api-enhanced.js"
  },
  "devDependencies": {
    "wrangler": "^3.100.0"
  }
}
