+  13: (state) => {
+    // 按 Cloudflare 出口的实测结果调默认解锁源
+    //
+    // 老用户本地持久化的是「波点开、网易云开、酷我关」，而实测在 Cloudflare 出口
+    // 只有网易云（GD 音乐台）能拿到直链：波点恒定回 20018「没有解锁付费歌曲」，
+    // 酷我 convert_url2 返回空响应。保持原样会让每次播放都为一个必然失败的源
+    // 白等一次往返。
+    //
+    // 只改「仍是旧默认值」的情况：用户手动改过的配置不动，否则就是覆盖用户选择。
+    const servers = state.songUnlockServer;
+    if (!Array.isArray(servers)) return {};
+
+    const isOldDefault =
+      servers.length === 3 &&
+      servers.every((s) => {
+        if (s.key === SongUnlockServer.BODIAN) return s.enabled === true;
+        if (s.key === SongUnlockServer.NETEASE) return s.enabled === true;
+        if (s.key === SongUnlockServer.KUWO) return s.enabled === false;
+        return true;
+      });
+    if (!isOldDefault) return {};
+
+    return {
+      songUnlockServer: [
+        { key: SongUnlockServer.NETEASE, enabled: true },
+        { key: SongUnlockServer.BODIAN, enabled: false },
+        { key: SongUnlockServer.KUWO, enabled: false },
+      ],
+    };
+  },
 };
